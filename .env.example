# -------------------------------------------------------------
# VERİTABANI BAĞLANTISI (Supabase / PostgreSQL)
# Supabase Proje Ayarları -> Database -> Connection string (URI)
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# SUPABASE REALTIME & CLIENT (Shared Cart WebSockets)
# Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"


# -------------------------------------------------------------
# ADMİN KİMLİK DOĞRULAMA (JWT Secret)
# Güçlü rastgele 32 karakterlik bir anahtar girin
# -------------------------------------------------------------
JWT_SECRET="super-secret-cafe-qr-menu-admin-jwt-key-2026-secure"

# -------------------------------------------------------------
# UYGULAMA URL
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# AURA AI ASSISTANT (OpenAI)
# -------------------------------------------------------------
# Leave empty or set to "mock" for 100% FREE offline testing ($0.00 spend).
# When provisioned with a live key, gpt-4o-mini will be used exclusively.
OPENAI_API_KEY=""
AURA_CHAT_MODEL="gpt-4o-mini"
OPENAI_UPSELL_MODEL="gpt-4o-mini"
AURA_OFFLINE_MODE="false"



# -------------------------------------------------------------
# WHATSAPP ESCALATION NOTIFICATIONS (Meta Cloud API / Twilio)
# -------------------------------------------------------------
# Shift Manager Phone Number (E.164 format without +, e.g. 905321234567)
MANAGER_WHATSAPP_NUMBER="905321234567"

# Option A: Meta Cloud WhatsApp Business API (Recommended)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Option B: Twilio Fallback (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

